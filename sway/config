include /etc/sway/config.d/*

set $alt Mod1
set $win Mod4
set $mod $win

set $alacritty Alacritty
set $alcom     ALCOM
set $blender   Blender
set $discord   Discord
set $ffplay    FFplay
set $firefox   Firefox
set $game      Game
set $obs       OBS
set $spotify   Spotify
set $steam     Steam
set $unity     Unity
set $unityhub  UnityHub
set $vrchat    VRChat
set $wivrn     WiVRn

 #Solarized
set $S_yellow  #b58900
set $S_orange  #cb4b16
set $S_red     #dc322f
set $S_magenta #d33682
set $S_violet  #6c71c4
set $S_blue    #268bd2
set $S_cyan    #2aa198
set $S_green   #859900

#Dark
set $S_base03  #002b36
set $S_base02  #073642
set $S_base01  #586e75
set $S_base00  #657b83
set $S_base0   #839496
set $S_base1   #93a1a1
set $S_base2   #eee8d5
set $S_base3   #fdf6e3

#Light
#set $S_base03  #fdf6e3
#set $S_base02  #eee8d5
#set $S_base01  #93a1a1
#set $S_base00  #839496
#set $S_base0   #657b83
#set $S_base1   #586e75
#set $S_base2   #073642
#set $S_base3   #002b36

assign [app_id="ALCOM"]      $alcom
assign [app_id="Alacritty"]  $alacritty
assign [app_id="blender"]    $blender
assign [app_id="discord"]    $discord
assign [app_id="exe"]        $game
assign [app_id="firefox"]    $firefox
assign [app_id="obsproject"] $obs
assign [app_id="spotify"]    $spotify
assign [app_id="vrchat"]     $vrchat
assign [app_id="wivrn"]      $wivrn
assign [class="Unity"]       $unity
assign [class="ffplay"]      $ffplay
assign [class="firefox"]     $firefox
assign [class="steam$"]      $steam
assign [class="steam_app"]   $game
assign [class="unityhub"]    $unityhub
assign [title="Steam"]       $steam

bar {
  colors {
    background $S_base03
    statusline $S_base0
  }

  gaps 8
  height 16
  position top
  status_command i3status-rs
  status_edge_padding 0
  status_padding 0
}

bindsym --no-repeat $mod+4 kill
bindsym --no-repeat $mod+j move workspace output left
bindsym --no-repeat $mod+k move workspace output right
bindsym --no-repeat $mod+r reload

bindsym --no-repeat $mod+a workspace $alcom,     exec alcom
bindsym --no-repeat $mod+b workspace $firefox,   exec [ "$(pgrep firefox)" ] || firefox
bindsym --no-repeat $mod+d workspace $discord,   exec discord
bindsym --no-repeat $mod+g workspace $steam,     exec steam steam://unlockh264/
bindsym --no-repeat $mod+o workspace $obs,       exec obs
bindsym --no-repeat $mod+s workspace $spotify,   exec spotify
bindsym --no-repeat $mod+t workspace $alacritty, exec alacritty
bindsym --no-repeat $mod+u workspace $unityhub,  exec unityhub
bindsym --no-repeat $mod+w workspace $wivrn,     exec [ "$(pgrep wivrn-dashboard)" ] || wivrn-dashboard

bindsym --no-repeat $mod+s+Ctrl  exec swaymsg -t get_tree | jq -r '.. | select(.focused?) | .rect | "\(.x),\(.y) \(.width)x\(.height)"' | grim -g - ~/Pictures/"$(date +%F%T.png | sed 's/[-:]//g')"
bindsym --no-repeat $mod+s+Shift exec grim -g "$(slurp)" ~/Pictures/"$(date +%F%T.png | sed 's/[-:]//g')"

default_border none
default_floating_border none

font Ricty 10.5

for_window [app_id="exe"]               floating enable
for_window [class="steam_app"]          floating enable
for_window [title="Picture-in-Picture"] floating enable
for_window [title="^$"]                 floating enable, move position cursor

for_window [class="Unity"]          floating enable
for_window [title="OpenGL"]         floating disable
for_window [title="Vulkan"]         floating disable

for_window [title="Animation"]      resize set 50ppt 100ppt, move position center
for_window [title="Import Package"] resize set 30ppt 50ppt, move position center
for_window [title="MochiFitter"]    resize set 30ppt 70ppt, move position center
for_window [title="NDMF Console"]   resize set 30ppt 50ppt, move position -1000px 0
for_window [title="PopupWindow"]    move position cursor
for_window [title="Preview"]        resize set height 100ppt, move position center
for_window [title="Report"]         resize set 50ppt 70ppt, move position center
for_window [title="Select"]         resize set width 30ppt, move position center
for_window [title="VRChat SDK"]     resize set height 100ppt, move position 200px 0

gaps inner 8

input type:keyboard {
  repeat_delay 300
  repeat_rate 30
}

input type:touchpad {
  tap disabled
}

mouse_warping none

output * {
  background ~/repositories/dotfiles/wallpaper.png fill
  subpixel none
}

output DP-1 pos 1920 0
output DP-2 pos 0 0

workspace $alacritty output DP-2
workspace $discord   output DP-2
workspace $steam     output DP-2
workspace 0 output DP-1

exec rm -rf ~/.local/share/Steam/steamapps/compatdata/438100/pfx/drive_c/users/steamuser/AppData/LocalLow/VRChat/VRChat/Tools
exec gsettings set org.gnome.desktop.interface color-scheme prefer-dark
exec fcitx5
exec alacritty
exec discord
exec steam steam://unlockh264/

